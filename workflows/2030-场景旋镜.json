s","ue_properties":{"widget_ue_connectable":{},"input_ue_unconnectable":{},"version":"7.8"}},"widgets_values":["<sks> 左侧视角 平视 中景<br>图1 是正面参考图\n当前在生成右面，画面描述如下：\n右面是空间右墙，以平视视角转至右墙前\n左上是右墙前部顶部墙角\n左边是右墙前部，画面左边与图1 前面画面的右边重叠一致，书桌右边的深色转椅、右墙前的木质矮柜(带柜门、细腿)、柜上一盏亮着的暖黄色台灯、一台黑色长条音箱与一盆白色花盆的小绿植、柜上方墙上挂着一幅黑框横向山景装饰画(灰紫色层叠山峦图案)，与图1 右边完全一致\n左下是右墙前部底部地面，铺着浅色地毯边角\n上边是右墙上沿与浅色墙面\n中间是房间中央的深色木质书桌的右半，桌上放着一台打开的银色笔记本电脑，书桌朝向带窗户的前面墙(画面左边)，画面中只有一张书桌与一张转椅\n下边是右墙底墙角线与木地板\n右上是右墙后部顶部墙角，墙面干净\n右边是右墙后部墙面，干净浅色\n右下是右墙后部底部地面上放着的收纳纸箱\n整体是国漫CG风格的深夜书房右墙，暖色灯光，物体位置与前面画面一致，左边重叠区域与图1 前面画面右边吻合"],"widgets_values_named":{"text_0":"<sks> 左侧视角 平视 中景<br>图1 是正面参考图\n当前在生成右面，画面描述如下：\n右面是空间右墙，以平视视角转至右墙前\n左上是右墙前部顶部墙角\n左边是右墙前部，画面左边与图1 前面画面的右边重叠一致，书桌右边的深色转椅、右墙前的木质矮柜(带柜门、细腿)、柜上一盏亮着的暖黄色台灯、一台黑色长条音箱与一盆白色花盆的小绿植、柜上方墙上挂着一幅黑框横向山景装饰画(灰紫色层叠山峦图案)，与图1 右边完全一致\n左下是右墙前部底部地面，铺着浅色地毯边角\n上边是右墙上沿与浅色墙面\n中间是房间中央的深色木质书桌的右半，桌上放着一台打开的银色笔记本电脑，书桌朝向带窗户的前面墙(画面左边)，画面中只有一张书桌与一张转椅\n下边是右墙底墙角线与木地板\n右上是右墙后部顶部墙角，墙面干净\n右边是右墙后部墙面，干净浅色\n右下是右墙后部底部地面上放着的收纳纸箱\n整体是国漫CG风格的深夜书房右墙，暖色灯光，物体位置与前面画面一致，左边重叠区域与图1 前面画面右边吻合"}},{"id":45,"type":"StringConcatenate","pos":[4380,1150],"size":[230,260],"flags":{},"order":16,"mode":0,"inputs":[{"localized_name":"字符串A","name":"string_a","type":"STRING","widget":{"name":"string_a"},"link":88},{"localized_name":"字符串B","name":"string_b","type":"STRING","widget":{"name":"string_b"},"link":104},{"localized_name":"分隔符","name":"delimiter","type":"STRING","widget":{"name":"delimiter"},"link":null}],"outputs":[{"localized_name":"字符串","name":"STRING","type":"STRING","links":[89]}],"properties":{"Node name for S&R":"StringConcatenate","ue_properties":{"widget_ue_connectable":{},"input_ue_unconnectable":{},"version":"7.8"}},"widgets_values":["","","-"],"widgets_values_named":{"string_a":"","string_b":"","delimiter":"-"}},{"id":47,"type":"TextEncodeQwenImageEditPlus","pos":[3610,400],"size":[300,220],"flags":{},"order":17,"mode":0,"inputs":[{"localized_name":"clip","name":"clip","type":"CLIP","link":107},{"localized_name":"vae","name":"vae","shape":7