_name":"重算前馈","name":"refresh","type":"BOOLEAN","widget":{"name":"refresh"},"link":null}],"outputs":[{"localized_name":"PLY 路径","name":"ply_path","type":"STRING","slot_index":0,"links":[8]}],"title":"世界重建精修 PLY (接相机先验)","properties":{"Node name for S&R":"WorldRefinePLY","ue_properties":{"widget_ue_connectable":{"steps":true,"mode":true,"reg_opac":true,"reg_color":true,"target":true,"gt":true,"prune_opac":true,"refresh":true},"version":"7.8","input_ue_unconnectable":{}}},"widgets_values":[1500,"all",3,0.5,0.5,952,952,0,false],"widgets_values_named":{"steps":1500,"mode":"all","reg":3,"reg_opac":0.5,"reg_color":0.5,"target":952,"gt":952,"prune_opac":0,"refresh":false}},{"id":6,"type":"HYWM2PLYAdvancedGaussianViewer","pos":[2410,700],"size":[3290,2130],"flags":{},"order":6,"mode":0,"inputs":[{"localized_name":"ply_path","name":"ply_path","type":"STRING","link":8}],"outputs":[],"properties":{"Node name for S&R":"HYWM2PLYAdvancedGaussianViewer","ue_properties":{"widget_ue_connectable":{},"version":"7.8","input_ue_unconnectable":{}}},"widgets_values":[""],"widgets_values_named":{"ply_advanced_viewer":""}},{"id":15,"type":"MarkdownNote","pos":[0,40],"size":[340,980],"flags":{},"order":1,"mode":0,"inputs":[],"outputs":[],"properties":{"Node name for S&R":"MarkdownNote","ue_properties":{"widget_ue_connectable":{},"version":"7.8","input_ue_unconnectable":{}}},"widgets_values":["## 0034_世界模型 · 360° 视频 → 一个最高质量 3DGS PLY\n\n输入 = md 表(节点 1)的 `360环绕视频` 列；改表 → 点「刷新」→ Run。细节见\n`docs\\360视频横向展开长图-v2实现-2026-09-28.md`。\n\n**链路**：表 → `WorldSurroundPanorama`(视频 → 横向展开长图：等距圆柱条带、上行=天、无黑边、无重影，\n另出 `valid_band`/`v_center`) → `PreviewImageSave`(目视) ＋ `WorldPanoramaViews`(长图 → 重叠视角批\n＋ 每视角解析 w2c 外参/内参) → `WorldRefinePLY`(＋相机先验 → 504 前馈 → 3DGS 全参数精修 1500 步)\n→ PLY 视口。产物 `output\\0034_世界模型\\0034_世界模型_世界3DGS.ply`。\n\n**必接**：`valid_band→v_range`、`v_center→v_center`(否则切出黑边视角)；视角 72°/重叠 10% ⇒ 6 视角；\n`target`/`gt`=952、`reg`=3.0。\n\n**四个坑**：① 重影根源是上游自猜位姿 —— 本链把解析位姿当先验注入(`cond_flags=[cam,0,intr]`)；\n② 子进程 stdout 钉 UTF-8(否则中文路径乱码)；③ `f_dc_*` 落盘写原始 `sh[:,0]`(否则颜色做两遍变中灰)；\n④ 验收看 `/history` 的 `status_str`，不看退出码。\n"],"widgets_values_named":{"text":"## 0034_世界模型 · 360° 视频 → 一个最高质量 3DGS PLY\n\n输入 = md 表(节点 1)的 `360环绕视频` 列；改表 → 点「刷新」→ Run。细节见\n`docs\\360视频横向展开长图-v2实现-2026-09-28.md`。\n\n**链路**：表 → `WorldSurroundPanorama`(视频 → 横向展开长图：等距圆柱条带、上行=天、无黑边、无重影，\n另出 `valid_band`/`v_center`) → `PreviewImageSave`(目视) ＋ `WorldPanoramaViews`(长图 → 重叠视角批\n＋ 每视角解析 w2c 外参/内参) → `WorldRefinePLY`(＋相机先验 → 504 前馈 → 3DGS 全参数精修 1500 步)\n→ PLY 视口。产物 `output\\0034_世界模型\\0034_世界模型_世界3DGS.ply`。\n\n**必接**：`valid_band→v_range`、`v_center→v_center`(否则切出黑边视角)；视角 72°/重叠 10% ⇒ 6 视角；\n`target`/`gt`=952、`reg`=3.0。\n\n**四个坑**：① 重影根源是上游自猜位姿 —— 本链把解析位姿当先验注入(`cond_flags=[cam,0,intr]`)；\n② 子进程 stdout 钉 UTF-8(否则中文路径乱码)；③ `f_dc_*` 落盘写原始 `sh[:,0]`(否则颜色做两遍变中灰)；\n④ 验收看 `/history` 的 `status_str`，不看退出码。\n"},"color":"#432","bgcolor":"#653"}],"links":[[1,1,2,2,0,"VIDEO"],[2,2,0,3,0,"IMAGE"],[3,2,0,4,0,"IMAGE"],[4,2,1,4,4,"FLOAT"],[5,4,0,5,0,"IMAGE"],[6,4,1,5,1,"EXTRINSICS"],[7,4,2,5,2,"INTRINSICS"],[8,5,0,6,0,"STRING"],[9,2,2,4,5,"FLOAT"]],"groups":[],"config":{},"extra":{"ds":{"scale":0.45,"offset":[2887.777777777778,654]},"ue_links":[],"links_added_by_ue":[]},"version":0.4}