      "properties": {
        "cnr_id": "was-node-suite-comfyui",
        "ver": "ea935d1044ae5a26efa54ebeb18fe9020af49a45",
        "Node name for S&R": "Text Multiline",
        "ue_properties": {
          "widget_ue_connectable": {
